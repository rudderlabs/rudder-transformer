PORT=9090 # application's port
METRICS_PORT=9091 # metrics's port
ENABLE_FUNCTIONS=true # user transformation functions
CLUSTER_ENABLED=true # cluster mode
NUM_PROCS=1 # Number of workers in the cluster mode
CONFIG_BACKEND_URL="https://api.rudderstack.com"
# Optional. Basic-auth secret sent to the config backend when it requires authentication (hosted
# internal gateway). Leave unset for self-hosted config backends that serve these routes without auth.
CONFIG_BACKEND_HOSTED_SECRET=""
REDIS_HOST = localhost
REDIS_PORT = 6379
REDIS_PASSWORD = 123
REDIS_USERNAME = abc
USE_REDIS_DB = true
REDIS_EXPIRY_TIME_IN_SEC = 3600
